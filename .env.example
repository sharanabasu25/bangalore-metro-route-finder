# Bangalore Metro Route Finder - Environment Variables Example
# Copy this file to .env and add your Gemini API Key if you wish to use live Google Gemini AI.
# If no key is provided, the application runs gracefully using the built-in Intelligent Offline Assistant!

GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-1.5-flash
PORT=5000
FLASK_DEBUG=True
